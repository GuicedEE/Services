<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.guicedee</groupId>
        <artifactId>parent</artifactId>
        <version>2.4.0</version>
    </parent>
    <groupId>com.guicedee.modules.services</groupId>
    <artifactId>jna-platform-bridge</artifactId>
    <version>2.4.0</version>
    <packaging>jar</packaging>
    <name>JNA Platform JPMS Bridge</name>
    <description>Provides the JPMS name required by Azure Identity while using GuicedEE's shaded JNA implementation.</description>
    <properties>
        <project.scm.nameUrl>/GuicedEE/Services</project.scm.nameUrl>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.guicedee.modules.services</groupId>
            <artifactId>jna-platform</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <!-- This descriptor-only module has no Java packages for javadoc to render. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bridge-javadoc</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/main/javadoc</classesDirectory>
                            <includes><include>**/*.html</include></includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
