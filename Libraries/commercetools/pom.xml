<?xml version="1.0" ?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.1.0" xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>com.guicedee</groupId>
        <artifactId>parent</artifactId>
        <version>2.5.1</version>
    </parent>
    <groupId>com.guicedee.modules.services</groupId>
    <artifactId>commercetools</artifactId>
    <name>commercetools.sdk.java.api</name>
    <version>2.5.1</version>
    <properties>
        <project.scm.nameUrl>/GuicedEE/Services</project.scm.nameUrl>
    </properties>
    <description>Grouped Commercetools Java SDK, GraphQL models and HTTP client JPMS module.</description>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven.dependency.version}</version>
                <executions>
                    <execution>
                        <id>javadoc-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>compile</includeScope>
                            <outputDirectory>${project.build.directory}/javadoc-dependencies</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations combine.self="override">
                                <relocation>
                                    <pattern>org</pattern>
                                    <excludes>
                                        <!-- Native-image hosted APIs are supplied by the compiler, not shaded dependencies. -->
                                        <exclude>org.graalvm.**</exclude>
                                        <!-- JGSS is a JDK API; references must retain the platform package. -->
                                        <exclude>org.ietf.**</exclude>
                                        <exclude>org.slf4j.**</exclude>
                                        <exclude>org.apache.commons.**</exclude>
                                        <exclude>org.javamoney.**</exclude>
                                        <exclude>org.reactivestreams.**</exclude>
                                        <exclude>org.asynchttpclient.**</exclude>
                                        <exclude>org.bouncycastle.**</exclude>
                                        <exclude>org.w3c.**</exclude>
                                        <exclude>org.xml.**</exclude>
                                    </excludes>
                                    <shadedPattern>com.commercetools.internal.shaded.org</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google</pattern>
                                    <shadedPattern>com.commercetools.internal.shaded.com.google</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.spotify</pattern>
                                    <shadedPattern>com.commercetools.internal.shaded.com.spotify</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.github</pattern>
                                    <shadedPattern>com.commercetools.internal.shaded.io.github</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.opentelemetry</pattern>
                                    <shadedPattern>com.commercetools.internal.shaded.io.opentelemetry</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javax.annotation</pattern>
                                    <shadedPattern>com.commercetools.internal.shaded.javax.annotation</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>jakarta</pattern>
                                    <excludes>
                                        <exclude>jakarta.annotation.**</exclude>
                                    </excludes>
                                    <shadedPattern>com.commercetools.internal.shaded.jakarta</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.sun</pattern>
                                    <shadedPattern>com.commercetools.internal.shaded.com.sun</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javax.activation</pattern>
                                    <shadedPattern>com.commercetools.internal.shaded.javax.activation</shadedPattern>
                                </relocation>
                            </relocations>
                            <artifactSet>
                                <includes>
                                    <include>*:*</include>
                                </includes>
                                <excludes>
                                    <exclude>tools.jackson.core:jackson-core</exclude>
                                    <exclude>dev.failsafe:failsafe</exclude>
                                    <exclude>javax.money:money-api</exclude>
                                    <exclude>org.javamoney.moneta:moneta-core</exclude>
                                    <exclude>jakarta.annotation:jakarta.annotation-api</exclude>
                                    <exclude>com.fasterxml.jackson.core:jackson-annotations</exclude>
                                    <exclude>tools.jackson.core:jackson-databind</exclude>
                                    <exclude>org.apache.commons:commons-lang3</exclude>
                                    <exclude>org.slf4j:slf4j-api</exclude>
                                    <exclude>io.netty:netty-transport-native-epoll</exclude>
                                    <exclude>io.netty:netty-transport-classes-epoll</exclude>
                                    <exclude>io.netty:netty-transport-native-kqueue</exclude>
                                    <exclude>io.netty:netty-transport-classes-kqueue</exclude>
                                    <exclude>commons-io:commons-io</exclude>
                                    <exclude>io.netty:netty-codec</exclude>
                                    <exclude>io.netty:netty-common</exclude>
                                    <exclude>io.netty:netty-buffer</exclude>
                                    <exclude>io.netty:netty-transport</exclude>
                                    <exclude>io.netty:netty-codec-base</exclude>
                                    <exclude>io.netty:netty-codec-compression</exclude>
                                    <exclude>io.netty:netty-codec-http</exclude>
                                    <exclude>io.netty:netty-codec-socks</exclude>
                                    <exclude>io.netty:netty-handler-proxy</exclude>
                                    <exclude>io.netty:netty-handler</exclude>
                                    <exclude>io.netty:netty-resolver</exclude>
                                    <exclude>io.netty:netty-transport-native-unix-common</exclude>
                                    <exclude>org.reactivestreams:reactive-streams</exclude>
                                    <exclude>com.guicedee.modules.services:reactive-streams</exclude>
                                    <exclude>com.squareup.okhttp3:*</exclude>
                                    <exclude>com.squareup.okio:*</exclude>
                                    <exclude>com.guicedee.modules.services:okio</exclude>
                                    <exclude>org.jetbrains.kotlin:*</exclude>
                                    <exclude>org.bouncycastle:*</exclude>
                                    <exclude>com.github.luben:zstd-jni</exclude>
                                    <exclude>com.guicedee.modules.services:zstd-jni</exclude>
                                    <exclude>org.javassist:javassist</exclude>
                                    <exclude>com.guicedee.modules.services:javassist</exclude>
                                    <exclude>org.projectlombok:*</exclude>
                                    <exclude>org.junit*:*</exclude>
                                    <exclude>org.apiguardian:*</exclude>
                                    <exclude>org.opentest4j:*</exclude>
                                    <exclude>io.projectreactor.tools:*</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>reset-shaded-documentation</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- A wrapper has no own sources: never feed a previous shaded
                                 source archive back into the next shade execution. -->
                            <target>
                                <delete file="${project.build.directory}/${project.build.finalName}-sources.jar"/>
                                <delete file="${project.build.directory}/${project.build.finalName}-shaded-sources.jar"/>
                                <delete file="${project.build.directory}/original-${project.build.finalName}-sources.jar"/>
                                <delete dir="${project.build.directory}/source-output"/>
                                <delete dir="${project.build.directory}/reports/apidocs"/>
                                <delete dir="${project.build.directory}/javadoc-dependencies"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>normalize-javadoc-source-relocations</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <!-- Match source imports to namespaces excluded from bytecode relocation. -->
                                <replace dir="${project.build.directory}/source-output" includes="com/commercetools/**/*.java,io/vrap/**/*.java" token="com.commercetools.internal.shaded.org.asynchttpclient" value="org.asynchttpclient"/>
                                <replace dir="${project.build.directory}/source-output" includes="com/commercetools/**/*.java,io/vrap/**/*.java" token="com.commercetools.internal.shaded.org.slf4j" value="org.slf4j"/>
                                <replace dir="${project.build.directory}/source-output" includes="com/commercetools/**/*.java,io/vrap/**/*.java" token="com.commercetools.internal.shaded.org.apache.commons" value="org.apache.commons"/>
                                <replace dir="${project.build.directory}/source-output" includes="com/commercetools/**/*.java,io/vrap/**/*.java" token="com.commercetools.internal.shaded.org.javamoney" value="org.javamoney"/>
                                <replace dir="${project.build.directory}/source-output" includes="com/commercetools/**/*.java,io/vrap/**/*.java" token="com.commercetools.internal.shaded.org.reactivestreams" value="org.reactivestreams"/>
                                <replace dir="${project.build.directory}/source-output" includes="com/commercetools/**/*.java,io/vrap/**/*.java" token="com.commercetools.internal.shaded.jakarta.annotation" value="jakarta.annotation"/>
                                <pathconvert property="commerce.javadoc.classpath" targetos="unix" pathsep="${path.separator}">
                                    <path>
                                        <pathelement location="${project.build.directory}/${project.build.finalName}.jar"/>
                                        <fileset dir="${project.build.directory}/javadoc-dependencies" includes="*.jar"/>
                                    </path>
                                </pathconvert>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.guicedee.maven</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.coderplus.maven.plugins</groupId>
                <artifactId>copy-rename-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc</id>
                        <configuration>
                            <!-- Document the Commercetools and RMF API against this build's binary.
                                 Bundled implementation sources are not a compilable source project. -->
                            <maxmemory>2048m</maxmemory>
                            <sourceFileIncludes>
                                <include>com/commercetools/**/*.java</include>
                                <include>io/vrap/**/*.java</include>
                            </sourceFileIncludes>
                            <sourceFileExcludes>
                                <exclude>com/commercetools/internal/shaded/**</exclude>
                            </sourceFileExcludes>
                            <offlineLinks combine.self="override"/>
                            <additionalOptions combine.self="override">
                                <additionalOption>-Xdoclint:none</additionalOption>
                                <additionalOption>--class-path</additionalOption>
                                <!-- Enumerate dependency JARs and normalize Windows separators for the argument file. -->
                                <additionalOption>${commerce.javadoc.classpath}</additionalOption>
                                <additionalOption>--source-path</additionalOption>
                                <additionalOption>../../javadoc-empty-sourcepath</additionalOption>
                            </additionalOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <url>https://guicedee.com</url>
    <dependencies>
        <dependency>
            <groupId>com.commercetools.sdk</groupId>
            <artifactId>commercetools-sdk-java-api</artifactId>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>org.javassist</groupId>
                    <artifactId>javassist</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.reactivestreams</groupId>
                    <artifactId>reactive-streams</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.commercetools.sdk</groupId>
            <artifactId>commercetools-http-client</artifactId>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>org.javassist</groupId>
                    <artifactId>javassist</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.reactivestreams</groupId>
                    <artifactId>reactive-streams</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.guicedee.modules.services</groupId>
            <artifactId>javassist</artifactId>
            <version>${guicedee.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bctls-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>com.guicedee.modules.services</groupId>
            <artifactId>zstd-jni</artifactId>
            <version>${guicedee.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.failsafe</groupId>
            <artifactId>failsafe</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.money</groupId>
            <artifactId>money-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.javamoney.moneta</groupId>
            <artifactId>moneta-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-epoll</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-kqueue</artifactId>
            <classifier>osx-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-kqueue</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-base</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-compression</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <dependency>
